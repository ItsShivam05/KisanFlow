# KisanFlow AI & Optimization Service Configuration

# Service Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Market Intelligence Prototype (Optional Gemini API key for real-time market price estimation)
# Note: System falls back gracefully to simulated/historical market signal if key is omitted.
GEMINI_API_KEY=

# Model and Data Paths
MODEL_PATH=models/demand_model.joblib
RAW_DATA_PATH=data/raw/demand_raw.csv
PROCESSED_DATA_PATH=data/processed/demand_processed.csv
SEEDS_DIR=data/seeds/

# Optimization Defaults
VEHICLE_CAPACITY_KG=5000
COST_PER_KM=20.0
FIXED_VEHICLE_COST=1000.0
ROAD_CIRCUITY_FACTOR=1.28
